# NutriReg AI FastAPI Backend — Environment Configuration
# Copy to `.env` for local development. In Render, set these in the Web Service Environment.

# ---------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ---------------------------------------------------------------------------
# On Render: Use the Internal Database URL when the Web Service and Database
# are in the same Render region (private networking, faster, no egress costs).
INTERNAL_DATABASE_URL=postgresql://nutrireg_user:password@dpg-xxxxxx-a:5432/nutrireg_db

# Standard connection string fallback (or for external hosting e.g. Supabase, Neon)
DATABASE_URL=postgresql://nutrireg_user:password@host:5432/nutrireg_db

# Optional discrete database parameters (used if URL is not provided)
# DB_HOST=
# DB_PORT=5432
# DB_NAME=nutrireg_db
# DB_USER=
# DB_PASSWORD=

# SSL Mode (e.g. 'require', 'disable', 'prefer')
# External databases typically require 'require'; Render internal network uses 'disable'.
# DB_SSL=
# DB_SSLMODE=

# Connection pool settings
# DB_POOL_MIN=1
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT=15.0
# DB_COMMAND_TIMEOUT=30.0

# ---------------------------------------------------------------------------
# API & Security
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-frontend.vercel.app

# Session configuration
# SESSION_TTL_HOURS=12
# COOKIE_SECURE=true

# Development-only bypass (NEVER enable in production!)
# DEV_LOGIN_ENABLED=false

# ---------------------------------------------------------------------------
# AI / LLM Integration
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# File Storage
# ---------------------------------------------------------------------------
# Defaults to /tmp/uploads on Render/Vercel serverless environments
# UPLOAD_DIR=/tmp/uploads
